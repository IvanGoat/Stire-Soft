# Configuración de la base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=basestire

# Configuración de JWT
JWT_SECRET=supersecret123
JWT_EXPIRATION=1h

# Configuración del Tutor Inteligente (LLM)
# Dejar OPENAI_API_KEY vacío para usar respuestas simuladas (modo desarrollo)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_RETRY_COUNT=3

# Configuración de Redis (Obligatorio para BullMQ / Judge Engine)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Entorno Operativo (Obligatorio para TypeORM/Seguridad)
NODE_ENV=development

# Puerto del servidor
PORT=3001

# Sandbox de ejecucion de codigo de estudiantes (Judge Engine)
#   hardened (default) -> proceso hijo aislado por --permission de Node,
#                          sin infraestructura externa. Unica opcion real hoy.
#   docker  -> ABORTA el arranque: el adaptador Docker aun no esta
#              implementado (el anterior era un mock que aprobaba cualquier
#              codigo con la palabra "correct" — P0-05 de la auditoria).
#   vm      -> ABORTA el arranque: node:vm tiene un escape de sandbox
#              confirmado (P0-01, lectura de secretos + ejecucion de comandos).
SANDBOX_TYPE=hardened

# Docker Config (Para el Judge Engine)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Logging
LOG_LEVEL=debug

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
